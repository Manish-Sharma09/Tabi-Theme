{% comment %}
  Collection Feature Section for Dawn Theme
  File: sections/collection-feature.liquid
{% endcomment %}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .collection-feature-grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_mobile }}, 1fr);
    gap: 2rem;
  }

  @media screen and (min-width: 750px) {
    .collection-feature-grid {
      grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    }
  }

  .collection-feature-slider {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
  }

  .collection-feature-slider .collection-feature-grid {
    width: max-content;
    grid-template-columns: repeat({{ section.blocks.size }}, 300px);
  }

  @media screen and (min-width: 750px) {
    .collection-feature-slider .collection-feature-grid {
      grid-template-columns: repeat({{ section.blocks.size }}, 400px);
    }
  }

  .collection-feature-item {
    display: block;
    text-decoration: none;
    color: inherit;
    position: relative;
    overflow: hidden;
    border-radius: {{ section.settings.border_radius }}px;
    scroll-snap-align: start;
    aspect-ratio: 1 / 1.2;
  }

  .collection-feature-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .collection-feature-item:hover .collection-feature-image {
    transform: scale(1.05);
  }

  .collection-feature-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(rgba(0, 0, 0, 0.1), rgba(0, 0, 0, 0.4));
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    color: white;
    padding: 2rem;
  }

  .collection-feature-title {
    font-size: {{ section.settings.title_size }}rem;
    font-weight: {{ section.settings.title_weight }};
    margin-bottom: 1rem;
    text-transform: {{ section.settings.title_transform }};
    letter-spacing: {{ section.settings.title_spacing }}px;
    color:white;
  }

  .collection-feature-button {
    display: inline-block;
    padding: {{ section.settings.button_padding_v }}px {{ section.settings.button_padding_h }}px;
    background: {{ section.settings.button_bg_color }};
    color: {{ section.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ section.settings.button_border_radius }}px;
    font-size: {{ section.settings.button_text_size }}rem;
    font-weight: {{ section.settings.button_text_weight }};
    text-transform: {{ section.settings.button_text_transform }};
    letter-spacing: {{ section.settings.button_letter_spacing }}px;
    transition: all 0.3s ease;
    border: {{ section.settings.button_border_width }}px solid {{ section.settings.button_border_color }};
  }

  .collection-feature-button:hover {
    background: {{ section.settings.button_hover_bg }};
    color: {{ section.settings.button_hover_text }};
    transform: translateY(-2px);
  }

  
{%- endstyle -%}

<div class="collection-feature-section section-{{ section.id }}-padding">
  <div class="page-width">
    {% if section.settings.section_title != blank %}
      <div class="section-header text-center">
        <h2 class="section-title">{{ section.settings.section_title }}</h2>
        {% if section.settings.section_description != blank %}
          <p class="section-description">{{ section.settings.section_description }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="collection-feature-container {% if section.settings.layout == 'slider' %}collection-feature-slider{% endif %}">
      <div class="collection-feature-grid">
        {% for block in section.blocks %}
          {% liquid
            if block.settings.collection != blank
              assign collection = collections[block.settings.collection]
              if block.settings.use_collection_image and collection.products.first.featured_image
                assign featured_image = collection.products.first.featured_image
              elsif block.settings.custom_image
                assign featured_image = block.settings.custom_image
              else
                assign featured_image = collection.featured_image
              endif
              assign collection_url = collection.url
              assign collection_title = collection.title
            else
              assign featured_image = block.settings.custom_image
              assign collection_url = block.settings.custom_url
              assign collection_title = block.settings.custom_title
            endif

            if block.settings.override_title != blank
              assign collection_title = block.settings.override_title
            endif
          %}

          <a
            class="collection-feature-item"
            href="{{ collection_url | default: '#' }}"
            aria-label="{{ collection_title | escape }}"
            {{ block.shopify_attributes }}
          >
            {% if featured_image %}
              <img
                src="{{ featured_image | image_url: width: 800 }}"
                alt="{{ collection_title | escape }}"
                class="collection-feature-image"
                width="{{ featured_image.width }}"
                height="{{ featured_image.height }}"
                loading="lazy"
              />
            {% else %}
              <div class="collection-feature-placeholder">
                {{ 'collection-1' | placeholder_svg_tag }}
              </div>
            {% endif %}

            <div class="collection-feature-overlay">
              <h3 class="collection-feature-title">{{ collection_title }}</h3>
              
              {% if block.settings.show_button %}
                <span class="collection-feature-button">
                  {{ block.settings.button_text | default: 'Shop Now' }}
                </span>
              {% endif %}
            </div>
          </a>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
