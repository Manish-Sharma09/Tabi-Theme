/* ========================================
   FIX: Duplicate Cart + Proper Visibility
======================================== */

/* Desktop → hide mobile cart */
@media (min-width: 990px) {
  .mobile-cart-icon {
    display: none !important;
  }
}

/* Mobile → hide desktop cart */
@media (max-width: 989px) {
  #cart-icon-bubble {
    display: none !important;
  }
}

/* ============================================================================
   MOBILE HEADER — SINGLE SOURCE OF TRUTH

   Target, at every width below 990px:

        [ ☰ ]            [ logo ]            [ 🔍 ] [ 🛒 ]

   Why the header kept rearranging itself before: the same look was being built
   from TWO different sets of elements depending on width —

     <= 580px   search = .header_link          cart = .mobile-cart-icon
     581-989px  search = .search_desktop_icon  cart = #cart-icon-bubble
                (both nested inside .header__icons)

   Different elements, different parents, different order rules and competing
   !important visibility flags. Crossing 580px swapped the entire mechanism.

   Now there is ONE regime for the whole mobile range. The mobile trio renders;
   .header__icons is switched off completely (its account link and currency
   selector already live in the menu drawer footer, so nothing is lost).
   Desktop (>= 990px) is left as stock Dawn.

   Declared last in this stylesheet on purpose: an earlier @media block puts
   `justify-content: space-between` on a 7-class .header selector, so anything
   above it loses on source order.

   `.header` must remain the positioning context for the search modal
   (.modal__content is position:absolute; inset:0), so nothing inside
   .ctsm-section-added may be positioned or transformed. `display: contents`
   promotes the hamburger / search / cart to direct flex children of .header,
   which is what allows ordering them without a wrapper.
============================================================================ */
@media screen and (max-width: 989px) {
  header.header.page-width,
  header.header.header--middle-left.header--mobile-center.page-width.header--has-menu.header--has-social.header--has-account {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    column-gap: 0;
    position: relative;
  }

  header.header.page-width .ctsm-section-added {
    display: contents;
  }

  /* 1 — hamburger, hard left */
  header.header.page-width header-drawer {
    order: 1;
    flex: 0 0 auto;
    margin: 0;
    justify-self: start;
  }

  /* 2 — logo takes the slack, which is what pushes the icons right.

     BOTH selectors are required. Dawn only wraps the logo in an
     h1.header__heading on the homepage (one h1 per page, for SEO) — the
     wrapper is emitted inside a request.page_type == 'index' conditional.

     On every other template there is no .header__heading element at all — the
     bare <a class="header__heading-link"> is the flex child. Targeting only
     .header__heading meant the logo kept order: 0 on inner pages and sorted
     ahead of the hamburger, which is why the header looked right on the
     homepage and wrong everywhere else. */
  header.header.page-width .header__heading,
  header.header.page-width > .header__heading-link {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    order: 2;
    margin: 0;
    /* logo_width is 90px; this leaves clearance for the hamburger on the left
       and the search + cart pair on the right even at 320px. */
    max-width: calc(100% - 18rem);
    z-index: 1;
    /* !important beats the pre-existing
       `.header--mobile-left .header__heading { text-align: left !important }`
       — mobile_logo_position is set to "left" in the theme editor. */
    text-align: center !important;
    justify-self: center !important;
  }

  header.header.page-width .header__heading-link {
    display: inline-block;
    padding: 0;
  }

  /* Dawn sets the wrapper to width: 100%, which stops the image centring
     inside it. */
  header.header.page-width .header__heading-logo-wrapper {
    width: auto;
    max-width: 100%;
    text-align: center;
  }

  header.header.page-width .header__heading-logo {
    display: block;
    margin: 0 auto;
  }

  /* Keep room for the logo even though it no longer contributes height. */
  header.header.page-width {
    min-height: 5.6rem;
  }

  /* 3 — search.
     The logo is absolutely positioned and no longer occupies flex space, so
     this auto margin is what pushes the search + cart pair to the right edge.
     It must live on THIS rule: a separate `margin-left: auto` declared earlier
     was being wiped by the `margin: 0` shorthand here. */
  header.header.page-width .header_link {
    order: 3;
    flex: 0 0 auto;
    display: block;
    margin: 0 0 0 auto;
  }

  /* 4 — cart, hard right */
  header.header.page-width .mobile-cart-icon {
    order: 4;
    flex: 0 0 auto;
    /* MUST stay `relative`, never `static`: .cart-count-bubble is
       position:absolute and needs this element as its containing block. With
       `static` the badge escapes to .header and lands in the top-left corner. */
    position: relative;
    transform: none;
    margin: 0;
  }

  header.header.page-width .mobile-cart-icon .cart-count-bubble {
    top: 0.2rem;
    right: 0.2rem;
    left: auto;
    bottom: auto;
  }

  /* The desktop icon group is off entirely on mobile — this is what stops the
     two regimes fighting. Account and currency are in the drawer footer. */
  header.header.page-width .header__icons {
    display: none !important;
  }

  /* The search modal spans the header, not just the icon that opens it. */
  .header_link .search-modal.modal__content {
    left: 0;
    right: 0;
    width: 100%;
  }
}

</style>

<script>
/* ============================================================
   Mobile Cart — Advanced Integration Script
   
   Handles:
   1. Cart drawer trigger (if cart type = drawer)
   2. Live count sync between mobile + desktop cart bubbles
   3. Pop animation when item is added to cart
   4. Shopify AJAX cart event listener for count updates
   ============================================================ */
(function() {
  'use strict';

  var mobileCartIcon = document.getElementById('mobile-cart-icon-bubble');
  if (!mobileCartIcon) return;

  /* ---------- Cart Drawer trigger (for drawer cart type) ---------- */
  var isDrawerCart = mobileCartIcon.hasAttribute('data-cart-drawer-trigger');

  if (isDrawerCart) {
    mobileCartIcon.addEventListener('click', function(e) {
      e.preventDefault();
      /* Try to open the cart drawer the same way the desktop icon does */
      var cartDrawer = document.querySelector('cart-drawer');
      if (cartDrawer && typeof cartDrawer.open === 'function') {
        cartDrawer.open(mobileCartIcon);
      } else {
        /* Fallback: navigate to cart page */
        window.location.href = mobileCartIcon.getAttribute('href');
      }
    });
  }

  /* ---------- Live count sync ---------- */
  function updateMobileCartCount(count) {
    var bubble = document.getElementById('mobile-cart-count-bubble');
    var svgWrapper = mobileCartIcon.querySelector('.svg-wrapper');

    if (count > 0) {
      /* Update or create the count bubble */
      if (!bubble) {
        bubble = document.createElement('div');
        bubble.id = 'mobile-cart-count-bubble';
        bubble.className = 'cart-count-bubble';
        mobileCartIcon.appendChild(bubble);
      }
      bubble.innerHTML = count < 100
        ? '<span aria-hidden="true">' + count + '</span>'
        : '';

      /* Swap to filled cart icon */
      if (svgWrapper) {
        /* Mirror what the desktop icon does — use existing icon SVGs */
        var existingDesktopCart = document.getElementById('cart-icon-bubble');
        if (existingDesktopCart) {
          var desktopSvgWrapper = existingDesktopCart.querySelector('.svg-wrapper');
          if (desktopSvgWrapper) {
            svgWrapper.innerHTML = desktopSvgWrapper.innerHTML;
          }
        }
      }

      /* Trigger pop animation */
      mobileCartIcon.classList.remove('cart-updated');
      void mobileCartIcon.offsetWidth; /* reflow to restart animation */
      mobileCartIcon.classList.add('cart-updated');
      setTimeout(function() {
        mobileCartIcon.classList.remove('cart-updated');
      }, 500);

    } else {
      /* Cart empty — remove bubble */
      if (bubble) bubble.remove();
    }
  }

  /* ---------- Listen to Shopify cart update events ---------- */

  /* Method 1: Custom event fired by theme's cart JS (cart-drawer.js / cart-notification.js) */
  document.addEventListener('cart:updated', function(e) {
    if (e.detail && typeof e.detail.cartData !== 'undefined') {
      var count = e.detail.cartData.item_count || 0;
      updateMobileCartCount(count);
    }
  });

  /* Method 2: MutationObserver — watches the desktop cart count bubble for changes
     This catches updates regardless of which JS triggers them */
  var desktopBubble = document.querySelector('#cart-icon-bubble .cart-count-bubble span[aria-hidden]');
  if (!desktopBubble) {
    /* Watch the parent for bubble being added/removed */
    var desktopCartIcon = document.getElementById('cart-icon-bubble');
    if (desktopCartIcon) {
      var observer = new MutationObserver(function() {
        var span = desktopCartIcon.querySelector('.cart-count-bubble span[aria-hidden]');
        var count = span ? parseInt(span.textContent, 10) : 0;
        updateMobileCartCount(count);
      });
      observer.observe(desktopCartIcon, { childList: true, subtree: true, characterData: true });
    }
  }

  /* Method 3: Shopify sections:load for theme editor preview sync */
  document.addEventListener('shopify:section:load', function() {
    var span = document.querySelector('#cart-icon-bubble .cart-count-bubble span[aria-hidden]');
    var count = span ? parseInt(span.textContent, 10) : 0;
    updateMobileCartCount(count);
  });

})();
</script>

