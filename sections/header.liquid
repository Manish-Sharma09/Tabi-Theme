/* ============================================
   MOBILE CART — Advanced Integration
   Scoped to the whole mobile range (max-width: 989px)
   Desktop behaviour untouched
   ============================================ */

/* Mobile cart icon inside ctsm-section-added */
.mobile-cart-icon {
  display: none;
}

@media (max-width: 989px) {
  .mobile-cart-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    text-decoration: none;
    color: inherit;
    padding: 0 4px;
    -webkit-tap-highlight-color: transparent;
  }

  /* Make the mobile cart icon same size as hamburger icon */
  .mobile-cart-icon .svg-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
  }

  .mobile-cart-icon .svg-wrapper svg,
  .mobile-cart-icon .svg-wrapper .icon {
    width: 22px;
    height: 22px;
  }

  /* Cart count bubble — mobile specific */
  .mobile-cart-icon .cart-count-bubble {
    position: absolute;
    top: 2px;
    right: 0px;
    background: rgb(var(--color-button));
    color: rgb(var(--color-button-text));
    border-radius: 50%;
    min-width: 18px;
    height: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 10px;
    font-weight: 600;
    line-height: 1;
    padding: 2px;
    pointer-events: none;
    /* Fallback if theme vars not set */
    background-color: #1a1a1a;
    color: #ffffff;
  }

  /* Pulse animation when item is added to cart */
  @keyframes cart-pop {
    0%   { transform: scale(1); }
    40%  { transform: scale(1.35); }
    70%  { transform: scale(0.9); }
    100% { transform: scale(1); }
  }
  .mobile-cart-icon.cart-updated .cart-count-bubble {
    animation: cart-pop 0.4s ease-out;
  }

  /* Touch ripple effect on tap */
  .mobile-cart-icon:active .svg-wrapper {
    opacity: 0.65;
    transform: scale(0.92);
    transition: transform 0.1s ease, opacity 0.1s ease;
  }

  /* Ensure ctsm-section-added has proper spacing */
  .ctsm-section-added {
    gap: 2px;
  }
}
</style>
