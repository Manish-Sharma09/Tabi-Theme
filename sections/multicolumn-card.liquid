<div class="custom-slider page-width">
  {% for block in section.blocks %}
    <div class="slide">
      {% if block.settings.icon %}
        <img
          src="{{ block.settings.icon | image_url: width: block.settings.icon.width }}"
          alt="{{ block.settings.icon.alt | default: block.settings.title | escape }}"
          width="{{ block.settings.icon.width }}"
          height="{{ block.settings.icon.height }}"
          loading="lazy"
        >
      {% endif %}
      <h3>{{ block.settings.title }}</h3>
      <p>{{ block.settings.description }}</p>
    </div>
  {% endfor %}
</div>

{% schema %}
{
  "name": "Custom Slick Slider",
  "settings": [],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature Block",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Feature Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Feature Title",
          "default": "Feature Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Feature Description",
          "default": "Feature description text goes here."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Slick Slider",
      "category": "Custom"
    }
  ]
}
{% endschema %}
<style>
  .custom-slider {
    width: 100%;
    text-align: center;
  }
  .slide {
    padding: 20px;
    border-radius: 10px;
    text-align: center;
  }
  .slide img {
    max-width: 100px;
   margin: 0 auto;
  }
  .slick-prev-pre, .slick-next-nest {
    /* background:#798c9c !important; */
  }
.custom-slider:not(.slick-initialized){
  display:none;
  overflow:hidden;
}
  .slick-prev-pre,
.slick-next-nest {
  font-size: 24px;
  color: #ffffff;
  background: none;
  border-radius: 50%;
  width: 40px;
  height: 40px;
  border: none;
  position: absolute;
  line-height: 2px;
  top: 50%;
  transform: translateY(-50%);
}
.slick-prev-pre {
  left: 50px;
  z-index: 1;
}
.slick-next-nest {
  right: 50px;
}
@media(max-width: 580px){
.slick-prev-pre {
  left: 5px;
  z-index: 1;
}
.slick-next-nest {
  right: 5px;
}

}
</style>

<script>
  $(document).ready(function(){
    $('.custom-slider').slick({
      dots: false,
      infinite: true,
      speed: 500,
      slidesToShow: 3,
      slidesToScroll: 1,
      arrows: true,
       nextArrow: '<button type="button" class="slick-next-nest"><svg fill="#000000" width="14px" height="14px" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg"><polygon points="150.46 478 129.86 456.5 339.11 256 129.86 55.49 150.46 34 382.14 256 150.46 478"/></svg></button>',
      prevArrow: '<button type="button" class="slick-prev-pre"><svg fill="#000000" width="20px" height="20px" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg"><path d="M33.934,54.458l30.822,27.938c0.383,0.348,0.864,0.519,1.344,0.519c0.545,0,1.087-0.222,1.482-0.657 c0.741-0.818,0.68-2.083-0.139-2.824L37.801,52.564L64.67,22.921c0.742-0.818,0.68-2.083-0.139-2.824 c-0.817-0.742-2.082-0.679-2.824,0.139L33.768,51.059c-0.439,0.485-0.59,1.126-0.475,1.723 C33.234,53.39,33.446,54.017,33.934,54.458z"/></svg></button>',
      responsive: [
        {
          breakpoint: 1024,
          settings: {
            slidesToShow: 2
          }
        },
         {
          breakpoint: 580,
          settings: {
            slidesToShow: 1
          }
        }
      ]
    });
  });
</script>
