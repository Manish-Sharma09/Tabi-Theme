      <path d="M0,1h12.5" stroke-width="1"/>
    </svg>
  </button>
  <button class="filter-btn" data-cols="2">
    <svg class="m-svg-icon--small" width="10px" height="10px" fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 5.5 12.5">
      <path id="Rectangle" d="M.75 0a.76.76 0 01.75.75v11a.76.76 0 01-.75.75.76.76 0 01-.75-.75v-11A.76.76 0 01.75 0z" class="cls-1"></path>
      <path id="Rectangle-2" d="M4.75 0a.76.76 0 01.75.75v11a.76.76 0 01-.75.75.76.76 0 01-.75-.75v-11A.76.76 0 014.75 0z" class="cls-1" data-name="Rectangle"></path>
    </svg>
  </button>
  <button class="filter-btn desktop-only" data-cols="3">
    <svg class="m-svg-icon--small" width="10px" height="10px" fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 9.5 12.5">
      <path id="Rectangle" d="M.75 0a.76.76 0 01.75.75v11a.76.76 0 01-.75.75.76.76 0 01-.75-.75v-11A.76.76 0 01.75 0z" class="cls-1"></path>
      <path id="Rectangle-2" d="M4.75 0a.76.76 0 01.75.75v11a.76.76 0 01-.75.75.76.76 0 01-.75-.75v-11A.76.76 0 014.75 0z" class="cls-1" data-name="Rectangle"></path>
      <path id="Rectangle-3" d="M8.75 0a.76.76 0 01.75.75v11a.76.76 0 01-.75.75.76.76 0 01-.75-.75v-11A.76.76 0=" class="cls-1" data-name="Rectangle"></path>
    </svg>
  </button> 
  <button class="filter-btn desktop-only" data-cols="4">
    <svg class="m-svg-icon--small" width="10px" height="10px" fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 13.5 12.5">
      <path id="Rectangle" d="M.75 0a.76.76 0 01.75.75v11a.76.76 0 01-.75.75.76.76 0 01-.75-.75v-11A.76.76 0 01.75 0z" class="cls-1"></path>
      <path id="Rectangle-2" d="M4.75 0a.76.76 0 01.75.75v11a.76.76 0 01-.75.75.76.76 0 01-.75-.75v-11A.76.76 0 014.75 0z" class="cls-1" data-name="Rectangle"></path>
      <path id="Rectangle-3" d="M8.75 0a.76.76 0 01.75.75v11a.76.76 0 01-.75.75.76.76 0 01-.75-.75v-11A.76.76 0 018.75 0z" class="cls-1" data-name="Rectangle"></path>
      <path id="Rectangle-4" d="M12.75 0a.76.76 0 01.75.75v11a.76.76 0 01-.75.75.76.76 0 01-.75-.75v-11a.76.76 0 01.75-.75z" class="cls-1" data-name="Rectangle"></path>
    </svg>
  </button> 
</div>

<script>
  function applySavedGridLayout() {
    const savedCols = localStorage.getItem("activeGridCols") || "3"; 
    const productGrid = document.getElementById("product-grid");
    const buttons = document.querySelectorAll(".filter-btn");
    if (productGrid) {
      productGrid.classList.remove(
        "grid-cols-1", "grid-cols-2", "grid-cols-3", "grid-cols-4"
      );
      productGrid.classList.add(`grid-cols-${savedCols}`);
    }
    buttons.forEach((btn) => {
      btn.classList.remove("active");
      if (btn.getAttribute("data-cols") === savedCols) {
        btn.classList.add("active");
      }
    });
  }
  function setupGridButtons() {
    const buttons = document.querySelectorAll(".filter-btn");
    const productGrid = document.getElementById("product-grid");
    buttons.forEach((button) => {
      button.addEventListener("click", function () {
        let cols = this.getAttribute("data-cols");
        localStorage.setItem("activeGridCols", cols);
        applySavedGridLayout();
      });
    });
    function updateGridForMobile() {
      if (window.innerWidth <= 580) {
        const currentCols = localStorage.getItem("activeGridCols");
        if (currentCols === "3") {
          localStorage.setItem("activeGridCols", "2");
          applySavedGridLayout();
        }
      }
    }
    window.addEventListener("resize", updateGridForMobile);
    updateGridForMobile();
  }
  document.addEventListener("DOMContentLoaded", function () {
    applySavedGridLayout();
    setupGridButtons();
  });
  document.addEventListener("shopify:section:load", function () {
    applySavedGridLayout();
    setupGridButtons();
  });
</script>

<style>
  .filter-buttons {
    display: flex;
    justify-content: end;
    gap: 10px;
  }
  .filter-btn {
    padding: 8px 15px;
    border: none;
    cursor: pointer;
    border-radius: 5px;
  }
  .filter-btn.active {
    background: #000;
    color: #fff;
  }
  .grid-cols-1 {
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px;
  }
  .grid-cols-2 {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
  }
  .grid-cols-3 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
  }
  .grid-cols-4 {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
  }
  .filter-btn.new-cstm {
    display: none;
  }
  @media (max-width: 767px) {
    .grid-cols-1, .grid-cols-2 {
      display: grid;
    }
    .desktop-only {
      display: none;
    }
    .grid-cols-3 {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
    }
    .filter-btn.new-cstm {
      display: block;
    }
  }
  @media (min-width: 768px) {
    .grid-cols-3 {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
    }
    .filter-btn.desktop-only {
      display: inline-block;
    }
  }
</style>
